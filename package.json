{
  "name": "@locationdrive/mcp",
  "version": "1.0.3",
  "description": "Official MCP server for the Location Drive API - global POI data, graded building polygons, EV/fuel/menu/hotel data packs.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "locationdrive-mcp": "dist/stdio.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.api.json",
    "prepublishOnly": "npm run build",
    "start": "node dist/stdio.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/stdio.js",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/locationdrive/mcp.git"
  },
  "bugs": {
    "url": "https://github.com/locationdrive/mcp/issues"
  },
  "keywords": [
    "mcp",
    "poi",
    "location-data",
    "polygons",
    "geospatial",
    "claude"
  ],
  "homepage": "https://locationdrive.com/docs"
}
